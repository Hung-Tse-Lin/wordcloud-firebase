rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 測試集合：允許讀寫
    match /test_collection/{document} {
      allow read, write: if true;
    }

    // 教學工具常用集合範例
    match /wordcloud_words/{document} {
      allow read, write: if true;
    }

    // 其他集合預設禁止存取
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
